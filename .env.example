# ChatBox — server-side secrets (EXAMPLE ONLY — never put real values here)
#
# Copy to `.env` for local tooling only. `.env` is git-ignored and must
# NEVER be committed. Real secrets are set in the Supabase / Cloudflare
# dashboards — see DEPLOY_GUIDE.md. The Supabase anon key is NOT listed
# here: it is public by design and already embedded in index.html.

# Supabase service_role key (server-side only — Edge Functions / admin scripts)
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY_HERE

# TURN server shared secret (voice calls — Metered / coturn)
TURN_SHARED_SECRET=YOUR_TURN_SHARED_SECRET_HERE

# Web Push (VAPID) private key — server side of send-push
VAPID_PRIVATE_KEY=YOUR_VAPID_PRIVATE_KEY_HERE

# Brevo API key — password-reset / welcome emails
BREVO_API_KEY=YOUR_BREVO_API_KEY_HERE

# Cloudflare Realtime (group audio calls) — app id is a public identifier,
# the app secret is the secret. Both are set in the Cloudflare dashboard.
CLOUDFLARE_REALTIME_APP_ID=YOUR_CLOUDFLARE_REALTIME_APP_ID_HERE
CLOUDFLARE_REALTIME_APP_SECRET=YOUR_CLOUDFLARE_REALTIME_APP_SECRET_HERE

# Shared secret for the cleanup-expired-media Edge Function
CLEANUP_SECRET=YOUR_CLEANUP_SECRET_HERE
